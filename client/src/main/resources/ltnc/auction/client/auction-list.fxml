<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ltnc.auction.client.controller.AuctionListController"
           stylesheets="@/styles.css" styleClass="app-root">
    <VBox fx:id="authView" alignment="CENTER" spacing="18" styleClass="auth-wrap">
        <Label text="BIDWISE" styleClass="brand"/>
        <Label text="Nền tảng đấu giá trực tuyến" styleClass="subtitle"/>
        <VBox spacing="12" styleClass="card auth-card">
            <Label text="Đăng nhập" styleClass="section-title"/>
            <TextField fx:id="loginUsername" promptText="Tên đăng nhập"/>
            <PasswordField fx:id="loginPassword" promptText="Mật khẩu"/>
            <Button text="Đăng nhập" onAction="#signIn" styleClass="primary-button" maxWidth="Infinity"/>
            <Button text="Tạo tài khoản người bán / người đấu giá" onAction="#showRegister" styleClass="link-button"
                    maxWidth="Infinity"/>
            <Label fx:id="authMessage" wrapText="true" styleClass="muted"/>
        </VBox>
        <Label text="Đăng nhập và đăng ký tài khoản qua server." styleClass="muted"/>
    </VBox>

    <VBox fx:id="registerView" visible="false" managed="false" alignment="CENTER" spacing="18" styleClass="auth-wrap">
        <Label text="Tạo tài khoản" styleClass="brand"/>
        <VBox spacing="12" styleClass="card auth-card">
            <Label text="Đăng ký" styleClass="section-title"/>
            <TextField fx:id="registerUsername" promptText="Tên đăng nhập"/>
            <PasswordField fx:id="registerPassword" promptText="Mật khẩu"/>
            <ChoiceBox fx:id="registerRole" maxWidth="Infinity"/>
            <Button text="Tạo tài khoản" onAction="#register" styleClass="primary-button" maxWidth="Infinity"/>
            <Button text="Quay lại đăng nhập" onAction="#showLogin" styleClass="link-button" maxWidth="Infinity"/>
            <Label fx:id="registerMessage" wrapText="true" styleClass="muted"/>
        </VBox>
    </VBox>

    <BorderPane fx:id="adminView" visible="false" managed="false" styleClass="workspace">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
                <Label text="BIDWISE" styleClass="brand-small"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Quản trị hệ thống" styleClass="muted"/>
                <Button text="Đăng xuất" onAction="#signOut"/>
            </HBox>
        </top>
        <left>
            <VBox spacing="8" styleClass="sidebar">
                <Label text="QUẢN TRỊ" styleClass="eyebrow"/>
                <Button text="Tổng quan" styleClass="nav-item"/>
                <Button text="Tài khoản" styleClass="nav-item"/>
                <Button text="Sản phẩm &amp; phiên" styleClass="nav-item"/>
                <Button text="Lịch sử đấu giá" styleClass="nav-item"/>
            </VBox>
        </left>
        <center>
            <VBox spacing="18" styleClass="page">
                <Label text="Tổng quan hệ thống" styleClass="page-title"/>
                <Label text="Quản lý dữ liệu và hoạt động toàn sàn" styleClass="muted"/>
                <HBox spacing="12">
                    <VBox styleClass="metric">
                        <Label text="Tài khoản"/>
                        <Label text="—" styleClass="metric-value"/>
                    </VBox>
                    <VBox styleClass="metric">
                        <Label text="Phiên đang mở"/>
                        <Label text="—" styleClass="metric-value"/>
                    </VBox>
                    <VBox styleClass="metric">
                        <Label text="Lượt đặt giá"/>
                        <Label text="—" styleClass="metric-value"/>
                    </VBox>
                </HBox>
                <VBox styleClass="card" spacing="10">
                    <Label text="Quản lý toàn hệ thống" styleClass="section-title"/>
                    <Label text="Tài khoản • sản phẩm • giá hiện tại • lịch sử giao dịch" styleClass="muted"/>
                    <Label text="Các bảng dữ liệu sẽ được nối với API quản trị." styleClass="notice"/>
                </VBox>
            </VBox>
        </center>
    </BorderPane>

    <BorderPane fx:id="sellerView" visible="false" managed="false" styleClass="workspace">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
                <Label text="BIDWISE" styleClass="brand-small"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Khu vực người bán" styleClass="muted"/>
                <Button text="Đăng xuất" onAction="#signOut"/>
            </HBox>
        </top>
        <left>
            <VBox spacing="8" styleClass="sidebar">
                <Label text="NGƯỜI BÁN" styleClass="eyebrow"/>
                <Button fx:id="sellerNavProducts" text="Sản phẩm của tôi" onAction="#showSellerProducts"
                        styleClass="nav-item"/>
                <Button fx:id="sellerNavCreate" text="Tạo phiên đấu giá" onAction="#showSellerCreate"
                        styleClass="nav-item"/>
                <Button fx:id="sellerNavHistory" text="Kết quả &amp; lịch sử" onAction="#showSellerHistory"
                        styleClass="nav-item"/>
            </VBox>
        </left>
        <center>
            <StackPane alignment="TOP_LEFT">
                <!-- Trang 1: Sản phẩm của tôi -->
                <VBox fx:id="sellerProductsPage" spacing="16" styleClass="page">
                    <Label text="Sản phẩm của tôi" styleClass="page-title"/>
                    <Label text="Các sản phẩm bạn đã đăng và tình trạng phiên đấu giá" styleClass="muted"/>
                    <HBox spacing="14" VBox.vgrow="ALWAYS">
                        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Danh sách sản phẩm" styleClass="section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Làm mới" onAction="#loadSellerAuctions"/>
                                <Button text="+ Tạo phiên mới" onAction="#showSellerCreate"
                                        styleClass="primary-button"/>
                            </HBox>
                            <TableView fx:id="sellerProductTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="productNameColumn" text="Sản phẩm" prefWidth="150"/>
                                    <TableColumn fx:id="productTypeColumn" text="Loại" prefWidth="90"/>
                                    <TableColumn fx:id="productStartColumn" text="Giá khởi điểm" prefWidth="110"/>
                                    <TableColumn fx:id="productPriceColumn" text="Giá hiện tại" prefWidth="110"/>
                                    <TableColumn fx:id="productStatusColumn" text="Trạng thái" prefWidth="100"/>
                                    <TableColumn fx:id="productEndColumn" text="Kết thúc" prefWidth="140"/>
                                </columns>
                                <placeholder>
                                    <Label text="Bạn chưa đăng sản phẩm nào."/>
                                </placeholder>
                            </TableView>
                            <Label fx:id="sellerProductsMessage" wrapText="true" styleClass="muted"/>
                        </VBox>

                        <!-- Chi tiết sản phẩm khi được chọn -->
                        <VBox styleClass="card" spacing="12" prefWidth="380" minWidth="340">
                            <Label text="Chi tiết sản phẩm" styleClass="section-title"/>
                            <VBox fx:id="sellerDetailPlaceholder" alignment="CENTER" spacing="8" VBox.vgrow="ALWAYS"
                                  styleClass="notice">
                                <Label text="Chưa chọn sản phẩm" styleClass="section-title"/>
                                <Label text="Nhấn chọn một sản phẩm từ danh sách bên trái để xem đầy đủ thông tin chi tiết."
                                       wrapText="true" styleClass="muted"/>
                            </VBox>
                            <VBox fx:id="sellerDetailContent" spacing="10" visible="false" managed="false"
                                  VBox.vgrow="ALWAYS">
                                <VBox spacing="4">
                                    <Label fx:id="detailItemName" styleClass="detail-title" wrapText="true"/>
                                    <Label fx:id="detailItemCategory" styleClass="badge"/>
                                </VBox>
                                <Separator/>
                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="detail-scroll">
                                    <VBox spacing="10">
                                        <VBox spacing="3">
                                            <Label text="Mô tả" styleClass="detail-label"/>
                                            <Label fx:id="detailDescription" wrapText="true" styleClass="detail-value"/>
                                        </VBox>
                                        <VBox spacing="3">
                                            <Label text="Thông tin thuộc tính" styleClass="detail-label"/>
                                            <Label fx:id="detailExtraInfo" wrapText="true" styleClass="detail-value"/>
                                        </VBox>
                                        <Separator/>
                                        <GridPane hgap="12" vgap="8">
                                            <Label text="Giá khởi điểm:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="detailStartingPrice" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="0" styleClass="detail-value"/>

                                            <Label text="Bước giá:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="detailIncrement" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="1" styleClass="detail-value"/>

                                            <Label text="Giá hiện tại:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="detailCurrentPrice" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="2" styleClass="detail-highlight"/>

                                            <Label text="Trạng thái:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="detailStatus" GridPane.columnIndex="1" GridPane.rowIndex="3"
                                                   styleClass="detail-value"/>

                                            <Label text="Thời gian tạo:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="detailCreatedAt" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="4" styleClass="detail-value"/>

                                            <Label text="Thời gian kết thúc:" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="5" styleClass="detail-label"/>
                                            <Label fx:id="detailEndAt" GridPane.columnIndex="1" GridPane.rowIndex="5"
                                                   styleClass="detail-value"/>

                                            <Label text="Thời gian còn lại:" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="6" styleClass="detail-label"/>
                                            <Label fx:id="detailRemainingTime" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="6" styleClass="detail-countdown"/>
                                        </GridPane>
                                    </VBox>
                                </ScrollPane>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Trang 2: Tạo phiên đấu giá -->
                <VBox fx:id="sellerCreatePage" spacing="16" styleClass="page" visible="false" managed="false">
                    <Label text="Tạo phiên đấu giá" styleClass="page-title"/>
                    <Label text="Thiết lập sản phẩm, giá khởi điểm, bước giá và thời điểm kết thúc"
                           styleClass="muted"/>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="detail-scroll">
                        <HBox spacing="14">
                            <VBox styleClass="card form-card" spacing="10">
                                <Label text="Đăng sản phẩm / tạo phiên" styleClass="section-title"/>
                                <TextField fx:id="sellerItemName" promptText="Tên sản phẩm"/>
                                <TextArea fx:id="sellerItemDescription" promptText="Mô tả sản phẩm" prefRowCount="3"/>
                                <ChoiceBox fx:id="sellerItemType" maxWidth="Infinity"/>
                                <!-- Thuộc tính riêng của từng loại sản phẩm: chỉ nhóm ứng với loại đang chọn được hiển thị -->
                                <VBox fx:id="electronicsFields" spacing="10">
                                    <TextField fx:id="sellerBrand" promptText="Thương hiệu"/>
                                    <TextField fx:id="sellerWarranty" promptText="Bảo hành (tháng)"/>
                                </VBox>
                                <VBox fx:id="artFields" spacing="10" visible="false" managed="false">
                                    <TextField fx:id="sellerArtist" promptText="Tác giả / nghệ sĩ"/>
                                    <TextField fx:id="sellerYear" promptText="Năm sáng tác"/>
                                </VBox>
                                <VBox fx:id="vehicleFields" spacing="10" visible="false" managed="false">
                                    <TextField fx:id="sellerMileage" promptText="Số km đã đi"/>
                                    <TextField fx:id="sellerPlateNo" promptText="Biển số xe"/>
                                </VBox>
                                <TextField fx:id="sellerStartingPrice" promptText="Giá khởi điểm (VNĐ)"/>
                                <TextField fx:id="sellerIncrement" promptText="Bước nhảy tối thiểu (VNĐ)"/>
                                <VBox spacing="4">
                                    <Label text="Thời điểm kết thúc" styleClass="detail-label"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <DatePicker fx:id="sellerEndDate" promptText="Ngày kết thúc"
                                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                        <ComboBox fx:id="sellerEndHour" editable="true" prefWidth="74"
                                                  promptText="Giờ"/>
                                        <Label text=":" styleClass="detail-label"/>
                                        <ComboBox fx:id="sellerEndMinute" editable="true" prefWidth="74"
                                                  promptText="Phút"/>
                                    </HBox>
                                </VBox>
                                <Button text="Tạo phiên" onAction="#createAuction" styleClass="primary-button"/>
                                <Label fx:id="sellerMessage" wrapText="true" styleClass="notice"/>
                            </VBox>
                        </HBox>
                    </ScrollPane>
                </VBox>

                <!-- Trang 3: Kết quả & lịch sử -->
                <VBox fx:id="sellerHistoryPage" spacing="16" styleClass="page" visible="false" managed="false">
                    <Label text="Kết quả &amp; lịch sử" styleClass="page-title"/>
                    <Label text="Theo dõi người dẫn đầu, kết quả và lịch sử đặt giá của từng phiên" styleClass="muted"/>
                    <HBox spacing="14" VBox.vgrow="ALWAYS">
                        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Phiên của tôi" styleClass="section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Làm mới" onAction="#loadSellerAuctions"/>
                            </HBox>
                            <TableView fx:id="sellerResultTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="resultNameColumn" text="Sản phẩm" prefWidth="160"/>
                                    <TableColumn fx:id="resultPriceColumn" text="Giá cao nhất" prefWidth="120"/>
                                    <TableColumn fx:id="resultWinnerColumn" text="Người dẫn đầu / thắng"
                                                 prefWidth="150"/>
                                    <TableColumn fx:id="resultStatusColumn" text="Trạng thái" prefWidth="110"/>
                                </columns>
                                <placeholder>
                                    <Label text="Chưa có phiên đấu giá nào."/>
                                </placeholder>
                            </TableView>
                        </VBox>
                        <VBox styleClass="card" spacing="10" prefWidth="380">
                            <Label text="Lịch sử đặt giá" styleClass="section-title"/>
                            <TableView fx:id="sellerBidTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="sellerBidderColumn" text="Người đặt" prefWidth="110"/>
                                    <TableColumn fx:id="sellerBidAmountColumn" text="Mức giá" prefWidth="110"/>
                                    <TableColumn fx:id="sellerBidTimeColumn" text="Thời gian" prefWidth="140"/>
                                </columns>
                                <placeholder>
                                    <Label text="Chọn một phiên để xem lịch sử đặt giá."/>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </HBox>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>

    <BorderPane fx:id="bidderView" visible="false" managed="false" styleClass="workspace">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
                <Label text="BIDWISE" styleClass="brand-small"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Khu vực người đấu giá" styleClass="muted"/>
                <Button text="Đăng xuất" onAction="#signOut"/>
            </HBox>
        </top>
        <left>
            <VBox spacing="8" styleClass="sidebar">
                <Label text="NGƯỜI ĐẤU GIÁ" styleClass="eyebrow"/>
                <Button text="Khám phá phiên" onAction="#loadAuctions"
                        styleClass="nav-item nav-item-active"/>
                <Button text="Phiên đang tham gia" styleClass="nav-item"/>
                <Button text="Lịch sử đặt giá" styleClass="nav-item"/>
            </VBox>
        </left>
        <center>
            <VBox spacing="16" styleClass="page">
                <Label text="Khám phá phiên đấu giá" styleClass="page-title"/>
                <Label text="Tìm phiên phù hợp và theo dõi mức giá hiện tại" styleClass="muted"/>
                <VBox spacing="10" styleClass="card" style="-fx-padding: 12px 14px;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="bidderSearchField" promptText="Tìm theo tên sản phẩm hoặc mã phiên"
                                   HBox.hgrow="ALWAYS" onAction="#filterBidderAuctions"/>
                        <Button text="Tìm kiếm" onAction="#filterBidderAuctions" styleClass="primary-button"/>
                        <Button text="Đặt lại" onAction="#resetBidderFilters"/>
                        <Button text="Làm mới" onAction="#loadAuctions"/>
                    </HBox>
                    <FlowPane hgap="14" vgap="8" alignment="CENTER_LEFT">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Loại:" styleClass="detail-label"/>
                            <ComboBox fx:id="bidderTypeFilter" prefWidth="135"/>
                        </HBox>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Trạng thái:" styleClass="detail-label"/>
                            <ComboBox fx:id="bidderStatusFilter" prefWidth="145"/>
                        </HBox>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Sắp xếp:" styleClass="detail-label"/>
                            <ComboBox fx:id="bidderSortFilter" prefWidth="195"/>
                        </HBox>
                    </FlowPane>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Khoảng giá (VNĐ):" styleClass="detail-label"/>
                        <HBox spacing="6" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                            <Label text="Từ:" styleClass="muted"/>
                            <TextField fx:id="bidderMinPriceField" promptText="0" prefWidth="115"
                                       onAction="#filterBidderAuctions"/>
                            <Slider fx:id="bidderMinPriceSlider" min="0" max="100000000" value="0"
                                    HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <HBox spacing="6" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                            <Label text="Đến:" styleClass="muted"/>
                            <TextField fx:id="bidderMaxPriceField" promptText="Không giới hạn" prefWidth="115"
                                       onAction="#filterBidderAuctions"/>
                            <Slider fx:id="bidderMaxPriceSlider" min="0" max="100000000" value="100000000"
                                    HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </HBox>
                </VBox>

                <SplitPane orientation="HORIZONTAL" dividerPositions="0.65" VBox.vgrow="ALWAYS"
                           styleClass="clean-split-pane">
                    <items>
                        <SplitPane orientation="VERTICAL" dividerPositions="0.58" minWidth="320"
                                   styleClass="clean-split-pane">
                            <items>
                                <VBox styleClass="card" spacing="10" minHeight="150">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Danh sách phiên" styleClass="section-title"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Chọn phiên để xem chi tiết, lịch sử và đặt giá"
                                               styleClass="muted"/>
                                    </HBox>

                                    <TableView fx:id="bidderAuctionTable" prefHeight="250" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="bidderNameColumn" text="Tên sản phẩm" prefWidth="165"/>
                                            <TableColumn fx:id="bidderTypeColumn" text="Loại" prefWidth="95"/>
                                            <TableColumn fx:id="bidderPriceColumn" text="Giá hiện tại (VNĐ)"
                                                         prefWidth="135"/>
                                            <TableColumn fx:id="bidderStatusColumn" text="Trạng thái" prefWidth="115"/>
                                            <TableColumn fx:id="bidderRemainingColumn" text="Thời gian còn lại"
                                                         prefWidth="150"/>
                                        </columns>
                                        <placeholder>
                                            <Label text="Hiện chưa có phiên đấu giá phù hợp."/>
                                        </placeholder>
                                    </TableView>
                                </VBox>

                                <VBox styleClass="card" spacing="10" minHeight="130">
                                    <Label text="Lịch sử đặt giá"
                                           styleClass="section-title"/>

                                    <TableView fx:id="bidHistoryTable"
                                               prefHeight="185"
                                               VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="bidderColumn"
                                                         text="Người đặt"
                                                         prefWidth="120"/>

                                            <TableColumn fx:id="amountColumn"
                                                         text="Mức giá (VNĐ)"
                                                         prefWidth="150"/>

                                            <TableColumn fx:id="timeColumn"
                                                         text="Thời gian"
                                                         prefWidth="180"/>
                                        </columns>
                                        <placeholder>
                                            <Label text="Chọn phiên để xem lịch sử đặt giá."/>
                                        </placeholder>
                                    </TableView>
                                </VBox>
                            </items>
                        </SplitPane>

                        <VBox spacing="12" minWidth="260">
                        <!-- Chi tiết sản phẩm khi được chọn -->
                        <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                            <Label text="Chi tiết sản phẩm" styleClass="section-title"/>
                            <VBox fx:id="bidderDetailPlaceholder" alignment="CENTER" spacing="8" VBox.vgrow="ALWAYS"
                                  styleClass="notice">
                                <Label text="Chưa chọn sản phẩm" styleClass="section-title"/>
                                <Label text="Nhấn chọn một phiên từ danh sách bên trái để xem đầy đủ thông tin chi tiết."
                                       wrapText="true" styleClass="muted"/>
                            </VBox>
                            <VBox fx:id="bidderDetailContent" spacing="10" visible="false" managed="false"
                                  VBox.vgrow="ALWAYS">
                                <VBox spacing="4">
                                    <Label fx:id="bidderDetailItemName" styleClass="detail-title" wrapText="true"/>
                                    <Label fx:id="bidderDetailItemCategory" styleClass="badge"/>
                                </VBox>
                                <Separator/>
                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="detail-scroll">
                                    <VBox spacing="10">
                                        <VBox spacing="3">
                                            <Label text="Mô tả" styleClass="detail-label"/>
                                            <Label fx:id="bidderDetailDescription" wrapText="true"
                                                   styleClass="detail-value"/>
                                        </VBox>
                                        <VBox spacing="3">
                                            <Label text="Thông tin thuộc tính" styleClass="detail-label"/>
                                            <Label fx:id="bidderDetailExtraInfo" wrapText="true"
                                                   styleClass="detail-value"/>
                                        </VBox>
                                        <Separator/>
                                        <GridPane hgap="12" vgap="8">
                                            <Label text="Giá khởi điểm:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="bidderDetailStartingPrice" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="0" styleClass="detail-value"/>

                                            <Label text="Bước giá:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="bidderDetailIncrement" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="1" styleClass="detail-value"/>

                                            <Label text="Giá hiện tại:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="bidderDetailCurrentPrice" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="2" styleClass="detail-highlight"/>

                                            <Label text="Người dẫn đầu:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="bidderDetailLeader" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="3" styleClass="detail-value"/>

                                            <Label text="Trạng thái:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="bidderDetailStatus" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="4" styleClass="detail-value"/>

                                            <Label text="Thời gian tạo:" GridPane.columnIndex="0" GridPane.rowIndex="5"
                                                   styleClass="detail-label"/>
                                            <Label fx:id="bidderDetailCreatedAt" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="5" styleClass="detail-value"/>

                                            <Label text="Thời gian kết thúc:" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="6" styleClass="detail-label"/>
                                            <Label fx:id="bidderDetailEndAt" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="6" styleClass="detail-value"/>

                                            <Label text="Thời gian còn lại:" GridPane.columnIndex="0"
                                                   GridPane.rowIndex="7" styleClass="detail-label"/>
                                            <Label fx:id="bidderDetailRemainingTime" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="7" styleClass="detail-countdown"/>
                                        </GridPane>
                                    </VBox>
                                </ScrollPane>
                            </VBox>
                        </VBox>

                        <VBox styleClass="card" spacing="10">
                            <Label text="Đặt giá" styleClass="section-title"/>

                            <TextField fx:id="amountField"
                                       promptText="Giá muốn đặt (VNĐ)"/>

                            <Button text="Gửi mức giá"
                                    onAction="#placeBid"
                                    maxWidth="Infinity"
                                    styleClass="primary-button"/>

                            <Label fx:id="statusLabel"
                                   text="Danh sách đang tải…"
                                   wrapText="true"
                                   styleClass="notice"/>
                        </VBox>
                        </VBox>
                    </items>
                </SplitPane>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
